{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import"],
  "categories": { "correctness": "error", "suspicious": "warn" },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-unused-vars": "error",
    "no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true }],

    // Off: React Compiler rules (this app doesn't use the compiler).
    "react/incompatible-library": "off",
    "react/refs": "off",
    "react/purity": "off",
    "react/memo-dependencies": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/set-state-in-effect": "off",

    // Off: false positives for patterns used on purpose here (ARIA listbox/combobox, labelled switches,
    // chart render props, autofocus in dialogs, the error boundary reset, CSS side-effect imports).
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "react/no-unstable-nested-components": "off",
    "react/no-did-update-set-state": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": ["dist", "node_modules", "playwright-report", "test-results"]
}
